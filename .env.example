# CLI run/serve load .env from the current directory. Existing environment values win.
# Keep real credentials in .env, never in this example file.
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=replace-with-an-available-tool-calling-model

DASHSCOPE_API_KEY=replace-with-your-key
DASHSCOPE_BASE_URL=https://your-workspace.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-flash
# true respects HTTP(S)_PROXY / ALL_PROXY. Set false for a direct connection.
DASHSCOPE_USE_ENV_PROXY=true
